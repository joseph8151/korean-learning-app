# =============================================================================
# KoreanGo environment variables
#
# 1. Copy this file to `.env`
# 2. Fill in the values marked TODO
# 3. `.env` is git-ignored — never commit real keys
#
# Only EXPO_PUBLIC_* variables reach the app bundle. Anything secret (LLM API
# keys, Supabase service_role key, Google Play credentials) must NEVER be
# prefixed with EXPO_PUBLIC_ and must never live in this app at all.
# =============================================================================

# --- Supabase (optional for local development) -------------------------------
# The app runs on bundled content when these are empty, so you can develop the
# whole UI before connecting a backend.
#
# TODO: Supabase Dashboard → Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# TODO: Supabase Dashboard → Project Settings → API Keys → anon / public key.
# This key is safe in a mobile app ONLY because Row Level Security is enabled
# (see supabase/migrations). Do NOT use the service_role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- AI Korean Partner (optional) --------------------------------------------
# URL of a trusted backend that owns the LLM API key — e.g. a Supabase Edge
# Function deployed from supabase/functions/ai-chat.
# When empty, the app uses the built-in mock conversation partner.
#
# TODO: https://<your-project-ref>.functions.supabase.co/ai-chat
EXPO_PUBLIC_AI_PROXY_URL=

# =============================================================================
# The values below are NOT read by the app. They belong in EAS secrets or your
# CI provider, and are listed here only so you know what you still need.
# =============================================================================

# TODO (EAS): run `eas init`, then set this so app.config.ts can link builds.
# EAS_PROJECT_ID=

# TODO (server-side only — set with `supabase secrets set`, never here):
#   OPENAI_API_KEY / ANTHROPIC_API_KEY   for the AI chat Edge Function
#   SUPABASE_SERVICE_ROLE_KEY            for admin scripts and seeding
#
# TODO (Google Play — keep the JSON file out of git):
#   google-play-service-account.json     referenced by eas.json submit config
